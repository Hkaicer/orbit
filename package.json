{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "ORBIT - gestionnaire local et privé des candidatures, avec Claude comme assistant.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fastify/static": "10.1.7",
    "docx": "9.7.1",
    "fastify": "5.12.7",
    "imapflow": "2.4.0",
    "jszip": "3.10.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.104.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zustand": "5.0.16"
  }
}
